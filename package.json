{
  "name": "doc-writter-extension",
  "displayName": "Doc writter extension",
  "version": "0.0.1",
  "description": "A basic Plasmo extension.",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "framer-motion": "^12.42.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.22.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/chrome": "0.0.258",
    "@types/node": "^20.19.43",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*.amazon.com/*",
      "https://*.daraz.com.bd/*",
      "https://*.aliexpress.com/*",
      "https://api.aicandy.com/*",
      "http://localhost:5000/*",
      "http://localhost:3000/*",
      "https://assignment-writer-server.onrender.com/*"
    ],
    "permissions": [
      "activeTab",
      "scripting",
      "storage"
    ],
    "externally_connectable": {
      "matches": [
        "http://localhost:3000/*",
        "https://aicandy.com/*",
        "https://www.aicandy.com/*"
      ]
    }
  }
}

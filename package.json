{
  "name": "Dropecommerce",
  "displayName": "Dropecommerce",
  "version": "0.0.1",
  "description": "Automate your ecommerce product upload. Import product directly from Amazon, Daraz, Aliexpress, Moveon etc to your WordPress Woocommerce store. Save time, effort and money. Very helpfull for dropshippers, affiliate marketers and those who wants to automate their product importation.",
  "author": "Nabil Siddik. <nabilsiddik70@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "chrome": "^0.1.0",
    "framer-motion": "^12.42.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.22.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/chrome": "^0.0.258",
    "@types/node": "^20.19.43",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3"
  },
  "manifest": {
    "icons": {
      "16": "/assets/icon16.png",
      "32": "/assets/icon32.png",
      "48": "/assets/icon48.png",
      "128": "/assets/icon128.png"
    },
    "action": {
      "default_icon": {
        "16": "/assets/icon16.png",
        "32": "/assets/icon32.png",
        "48": "/assets/icon48.png"
      },
      "default_title": "Open Dropecommerce"
    },
    "externally_connectable": {
      "matches": [
        "http://localhost:3000/*",
        "https://assignment-writer-app.vercel.app/*",
        "http://200.97.171.7:5000/*"
      ]
    },
    "host_permissions": [
      "https://*.amazon.com/*",
      "https://*.daraz.com.bd/*",
      "https://*.aliexpress.com/*",
      "https://api.aicandy.com/*",
      "http://localhost:5000/*",
      "http://200.97.171.7:5000/*",
      "https://assignment-writer-server.onrender.com/*",
      "https://moveon.global/*",
      "https://pbs.com.bd/*",
      "https://www.wafilife.com/*",
      "http://localhost:3000/*"
    ],
    "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "sidePanel"
    ],
    "side_panel": {
    "default_path": "sidepanel.html"
  }
  }
}
